%
% --- spacing, etc. ---
%

\newcommand{\nl}{\vskip 0.0pc}
\newcommand{\noi}{\noindent}
\newcommand{\emp}[1]{{\bfseries {#1}}}
\newcommand{\capt}[1]{\caption{\small {\it {#1}}}}

\newcommand{\ls}[1]
   {\dimen0=\fontdimen6\the\font
    \lineskip=#1\dimen0
    \advance\lineskip.5\fontdimen5\the\font
    \advance\lineskip-\dimen0
    \lineskiplimit=.9\lineskip
    \baselineskip=\lineskip
    \advance\baselineskip\dimen0
    \normallineskip\lineskip
    \normallineskiplimit\lineskiplimit
    \normalbaselineskip\baselineskip
    \ignorespaces
   }
   
% Correct the spacing for figure captions, table captions and blockquotes - TAS 2026
\BeforeBeginEnvironment{quote}{\begin{singlespace}\ls{1}}
\AfterEndEnvironment{quote}{\end{singlespace}}
\BeforeBeginEnvironment{figure}{\begin{onehalfspace}\ls{1.5}}
\AfterEndEnvironment{figure}{\end{onehalfspace}}
\BeforeBeginEnvironment{table}{\begin{onehalfspace}\ls{1.5}}
\AfterEndEnvironment{table}{\end{onehalfspace}}
	
%Command to simplify the equation and symbol/abbreviation entry - TAS 2024
\newcommand{\eqDesc}[2]{\ref{#1} & \dotfill\phantom{Pag}\pageref{#1}}
\newcommand{\symbLine}[2]{#1\dotfill\phantom{Pag}#2}

