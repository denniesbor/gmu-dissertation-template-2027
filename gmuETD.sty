%
% --- abstract
%

\def\abstractpage{
	\pagebreak
	\baselineskip=0.25pc
	\lineskip=0.25pc
	\lineskiplimit=0.25pc
	\pagestyle{empty}
    \chapt*{Abstract}
    \phantomsection
    \addcontentsline{toc}{chapter}{Abstract}
	\baselineskip=1pc
	\lineskip=1pc
	\lineskiplimit=1pc
	\vskip 0.25cm
	\noi
	\ls{1}
	\rm\uppercase\expandafter{\@onelinetitle}
	\nl
	\baselineskip=1pc
	\lineskip=1pc
	\lineskiplimit=1pc
	\noi
	\if*\@credential
	   \@author
	\else
	   \@author, \@credential
	\fi
	\nl
	\noi
	George Mason University, \@degreeyear
	\nl
	\noi
	\if*\@coadvisorname
	   \@doctype\ Director: \@advisorname
	\else
	   \@doctype\ Directors: \@advisorname\\
	   \phantom{\@doctype\ Directors: }\@coadvisorname
	\fi
	\nl
	\vskip 46pt
}

