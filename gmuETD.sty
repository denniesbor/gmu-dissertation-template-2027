        %Took out the word by because not in the Word template - TAS 2026
        \begin{center}
                Copyright\ \copyright\ \@degreeyear\ \@author\\
                All Rights Reserved
        \end{center}
        \vfill
}

\def\beforepreface{
        \pagenumbering{roman}
        \pagestyle{plain}
        \signaturepage
        \titlepage
}

