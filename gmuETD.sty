% Define options for reference label and section depth (0 or 2)
\def\biblabelRef{0}
\def\secdepth{2}
\DeclareOption{nosecnum}{\renewcommand{\secdepth}{0}}
\ProcessOptions

% Remove section numbering for nosecnum option - TAS 2025
\if 0\secdepth
\renewcommand\thesection{\hskip -2ex}
\renewcommand\thesubsection{\hskip -2ex}
\renewcommand\thesubsubsection{\hskip -2ex}
\renewcommand\theparagraph{}
\renewcommand\thesubparagraph{}
\renewcommand{\thefigure}{\arabic{figure}}
\renewcommand{\thetable}{\arabic{figure}}
\fi

% Widow control
\widowpenalty10000
\clubpenalty10000

% Define equation numbering
\renewcommand{\theequation}{\arabic{chapter}.\arabic{equation}}
\newtheorem{lem}{Lemma}[section]
\newtheorem{prop}{Proposition}[section]
\newtheorem{assum}{Assumption}[section]
\newtheorem{Def}{Definition}[section]

