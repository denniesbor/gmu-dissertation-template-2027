\def\startofchapters{
% Set the first chapter flag
\def\flgFirstChapter{1}
}

%
% --- chapters ---
%

% Use \secdepth to get correct spacing - TAS 2025
\def\@chapter[#1]#2{%
	% Reset page and chapter counter for first chapter - TAS 2023
	\if1\flgFirstChapter
	    \renewcommand{\thepage}{\arabic{page}}
	    \setcounter{chapter}{0}
	    \setcounter{page}{1}
        \pagestyle{plain}
	    \renewcommand{\flgFirstChapter}{0}
	\fi
	\refstepcounter{chapter}
	\typeout{\@chapapp\space\thechapter.}	
	\if 0\secdepth
        \addcontentsline{toc}{chapter}{\hspace*{-1.25em}#1}
    \else
        \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter} #1}
    \fi
    \chaptermark{#1}
    \if@twocolumn
       \@topnewpage[\@makechapterhead{#2}]
    \else 
       \@makechapterhead{#2}
       \@afterheading
    \fi
}

\def\l@chapter{\vskip 0.0em plus 1pt
    \@dottedtocline{0}{0.0em}{1.35em}
}

% Use \secdepth to determine correct spacing - TAS 2025
\def\@makechapterhead#1{
    \parindent 0pt \raggedright
    \vspace*{0.27 in}
    \begin{center}
       \Large \bf 
	   \if 0\secdepth
	      #1 \par
	   \else
	      \thechapter. #1 \par
	   \fi
    \end{center}
    \nobreak
    \vskip 22 pt
}

%
% --- appendix chapters ---
%

% Use \secdepth to get right spacing - TAS 2025
\def\appchapter[#1]#2{
    \refstepcounter{chapter}
    \typeout{\@chapapp\space\thechapter.}
    \if 0\secdepth
       \addcontentsline{toc}{chapter}{\hspace*{-1.25em}#1}
    \else
       \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter} #1}
    \fi
    \chaptermark{#1}
    \if@twocolumn
       \@topnewpage[\@makeappchapterhead{#2}]
    \else 
       \@makeappchapterhead{#2}
       \@afterheading
    \fi
}

\def\appsection#1{
	\refstepcounter{section}
	\typeout{\@chapapp\space\thesection.}
	\chaptermark{#1}
	\if@twocolumn
	   \@topnewpage[\@makeappsectionhead{#1}]
	\else 
	   \@makeappsectionhead{#1}
	   \@afterheading
	\fi
}

% Use \secdepth to get correct spacing - TAS 2025
\def\@makeappchapterhead#1{
    \parindent 0pt \raggedright
    \vspace*{-0.48 in} % changing top margin of appendix from 2" to 1.25" (Muhammad Abdulla)
		{	\Large \bf
   			\if 0\secdepth
				\centerline{#1}
			\else
				\centerline{Appendix \thechapter: #1}
			\fi}
    \nobreak
    \vskip 22 pt
}

% Chapter Appendices still need centered - TAS 2025
\def\@makeappsectionhead#1{
	\parindent 0pt
\begin{center}
	\Large \bf
	#1 \par
\end{center}
\nobreak
\vskip 22 pt
}

%
% --- secondary chapters
%

\NewDocumentCommand{\chapt}{s o m}{%
	\clearpage
	\thispagestyle{plain}
	\global\@topnum\z@
	\@afterindentfalse

	\IfBooleanTF{#1}{\@schapt{#3}}{\IfNoValueTF{#2}{\@chapt[#3]{#3}}{\@chapt[#2]{#3}}}
}

%Sections before the TOC in the TOC
% Use \secdepth to get correct spacing - TAS 2025
\def\@chapt[#1]#2{
    \refstepcounter{chapter}
    \typeout{\@chapapp\space\thechapter.}
	\if 0\secdepth
       \addcontentsline{toc}{chapter}{\hspace*{-1.5em}#1}
    \else
       \addcontentsline{toc}{chapter}{\protect\numberline{}\hspace*{-1.5em}#1}
    \fi
    \chaptermark{#1}
    \if@twocolumn                                 % Tests for two-column mode.
       \@topnewpage[\@makechapthead{#2}]
    \else 
       \@makechapthead{#2}
       \@afterheading
    \fi
}                            

% Calls make heading for TOC
\def\@schapt#1{
	\if@twocolumn 
	   \@topnewpage[\@makeschapthead{#1}]
    \else 
       \@makeschapthead{#1}
       \@afterheading
    \fi
}

% Label on chapter
\def\@makechapthead#1{
    \parindent 0pt \raggedright
    \vspace*{0.325in}
    \centerline{\Large \bf #1} \par
    \nobreak
    \vskip 33pt
}

% TOC heading
\def\@makeschapthead#1{
    \parindent 0pt \raggedright
    \vspace*{0.325in}
\tagstructbegin{tag=H1}
\tagmcbegin{tag=H1}
    \centerline{\Large \bf #1} \par
    \tagmcend
\tagstructend
    \nobreak
    \vskip 33pt
}

%
% --- table of contents ---
%

\def\tableofcontents{
    \baselineskip=0.25pc
    \lineskip=0.25pc
    \lineskiplimit=0.25pc
    \@restonecolfalse
    \if@twocolumn
       \@restonecoltrue\onecolumn
    \fi
    \pagebreak
    \pdfbookmark{Table of Contents}{TOC}
	\chapt*{Table of Contents}\@mkboth{TABLE OF CONTENTS}{TABLE OF CONTENTS}
    \vskip -0.83 pc
    \hfill Page \par
    \lineskip=0.7pc     %%% USE FOR WIDER SPACING TOC
    \@starttoc{toc}
    \if@restonecol
       \twocolumn
    \fi
    \lineskip=0.25pc   %%% USE FOR WIDER SPACING TOC
}


% --List of Tables
% captiontable - a tabular environment nested within a table environment with
%                a label, an optional List of Tables entry and a caption

\def\captiontable#1{
    \@ifnextchar {\@captiontable{#1}}{\@dblarg{\@captiontable{#1}}}
}

\def\@captiontable#1[#2]#3{
    \def\@captionlabel{#1}
    \def\@captionlistentry{#2}
    \def\@captionheading{#3}
    \begin{table}
    \centering 
}

\def\endcaptiontable{
    \caption [\@captionlistentry]{\@captionheading}
    \label {\@captionlabel}
    \vspace*{7.6in}
    \end{table}
}

\def\listoftables{
	\@restonecolfalse
	\if@twocolumn
	   \@restonecoltrue\onecolumn
    \fi
    \pagebreak
	\chapt*{List of Tables}\@mkboth{LIST OF TABLES}{LIST OF TABLES}
    \phantomsection
    \addcontentsline{toc}{chapter}{List of Tables}
    \vskip -0.83 pc
    \hspace{0.5em}Table \hfill Page \par
    \lineskip=0.7pc  %%% USE FOR WIDER SPACING LOT
    \@starttoc{lot}
    \if @restonecol
       \twocolumn
    \fi
    \lineskip=0.25pc  %%% USE FOR WIDER SPACING LOT
}

%
% --- list of figures ---
%

\def\listoffigures{
	\@restonecolfalse
	\if@twocolumn
	   \@restonecoltrue\onecolumn
