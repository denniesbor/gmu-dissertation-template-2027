% Create the signature page
\def\signaturepage{
        \pagenumbering{roman}
        \pagestyle{plain}
        \thispagestyle{empty}%
        \null \vskip\topTitleSkip %.5825in,.01in
        \begin{center}
                \rm\uppercase\expandafter{\@title}\\
                \normalsize
                \bigskip by \\
                \bigskip \@author \\
                A \@doctype\ \\
                Submitted to the\\
                Graduate Faculty\\
                of\\
                George Mason University\\
                In Partial fulfillment of\\
                The Requirements for the Degree\\
                of\\
                \@degree\\
                \@discipline\\[\midTitleSkip] %[0.5 in]
        \end{center}
        Committee:\\[\lblTitleSkip] %[16 pt]
        % Remove all the automatic text and allow the author to enter TAS - 2023
        \siglinewithspace \@advisorsignline\\[\intercommspace]
        \if*\@coadvisorname
        \else
            \siglinewithspace \@coadvisorsignline\\[\intercommspace]
        \fi
        \siglinewithspace \@firstmember\\[\intercommspace]
        \siglinewithspace \@secondmember\\[\intercommspace]
        \if*\@thirdmember
        \else
            \siglinewithspace \@thirdmember\\[\intercommspace]
        \fi
	    \if*\@fourthmember
        \else
            \siglinewithspace \@fourthmember\\[\intercommspace]
        \fi
	    \if*\@fifthmember
        \else
            \siglinewithspace \@fifthmember\\[\intercommspace]
        \fi
	    \if*\@sixthmember
        \else
			\siglinewithspace \@sixthmember\\[\intercommspace]
		\fi
	  \if*\@nexttolast
      \else
        \siglinewithspace \@nexttolast\\[\intercommspace]
	  \fi
	  \if*\@lastsignature
      \else
        \siglinewithspace \@lastsignature\\[\intercommspace]
      \fi
        Date: \rule{\datelinelength}{\siglinedepth} \hspace{\spacesiglinename} \!\!\@degreesemester\
        \@degreeyear\\
        \phantom{Date: \rule{\datelinelength}{\siglinedepth} \hspace{\spacesiglinename}}George Mason University \\
        \phantom{Date: \rule{\datelinelength}{\siglinedepth} \hspace{\spacesiglinename}}Fairfax, VA
       \newpage
}

% Create the title page
\def\titlepage{
        \thispagestyle{empty}%
        \null\vskip .5825in
        \begin{center}
                \rm\expandafter{\@onelinetitle}\\[10 pt] %Needed title to be in caps
        \end{center}
        A \lowercase\expandafter{\@doctype} submitted in partial fulfillment of the requirements for
            the degree of \\ \@degree\ at George Mason University \\[10 pt]
        \begin{center}
        By \\[35 pt]
        \@author \\
        \if*\@thirddeg 
        \else
             \@thirddeg\\
             \@thirddegschool, \@thirddegyear
             \\
        \fi
        \if*\@seconddeg 
        \else
             \@seconddeg\\
             \@seconddegschool, \@seconddegyear
             \\
        \fi
        \@firstdeg\\
        \@firstdegschool, \@firstdegyear
        \\[39 pt]
        \if*\@coadvisorname
           Director: \@advisorname, Professor \\
           Department of \@deptadvisor \\[35 pt]
        \else
           Directors: \@advisorname, Professor\\
           Department of \@deptadvisor \\
           \@coadvisorname, Professor\\
           Department of \@deptcoadvisor\\[35 pt]
        \fi
        \@degreesemester\
        %Semester
        \@degreeyear \\
        George Mason University \\
        Fairfax, VA
        \end{center}
        \vfill
        \newpage
}

% Create the copyright page
\def\copyrightpage{
